# 由 python-dotenv 从项目根目录的 .env 加载（复制本文件为 .env）
# 已存在的系统环境变量优先级更高，临时覆盖时不用改文件
# 改了 .env 要重启进程 / 重开命令才会生效

# 任意 OpenAI 兼容服务：DeepSeek / 通义 / 智谱 / 本地 Ollama 都行
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 评估器用的模型，留空则复用 LLM_MODEL
# 建议换一个模型家族，避免生成模型给自己打分虚高
# 注意：deepseek-reasoner 等推理模型的思维链也算 max_tokens，
# 预算不够时会返回空正文（finish_reason=length），客户端会自动翻倍重试。
# 想要快且稳定，评分器用 deepseek-chat 就够
JUDGE_MODEL=

# 相对路径按项目根目录解析，不受启动目录影响
DATA_DIR=data
PASS_SCORE=8.0
# 不到 PASS_SCORE 时按评估建议自动重写，最多这么多次；之后停下等人审阅
MAX_REWRITES=3

# fake = 写入本地文件，不碰飞书；live = 真飞书
FEISHU_MODE=fake

# ---- live 模式必填 ----
# 开放平台 → 你的自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 导入目标文件夹 token（云空间文件夹 URL 里 fldcn... 那一段）
# 留空 = 应用云空间根目录；这种情况必须配 FEISHU_OWNER_OPEN_ID，否则你看不到文档
FEISHU_FOLDER_TOKEN=

# 文档建好后授予「完全访问」的人（ou_ 开头）
# 获取：开发者后台 API 调试台调用 contact/v3/users/batch_get_id（email/mobile 换 open_id）
FEISHU_OWNER_OPEN_ID=

# 审阅卡片发到这个群（oc_ 开头，用 note-agent feishu-chats 查）
# 留空 = 不发卡片，继续用本地 CLI / serve 审阅
FEISHU_CHAT_ID=

# 卡片里「看全文」按钮指向的地址；手机审阅就换成局域网 IP 或内网穿透地址
REVIEW_BASE_URL=http://127.0.0.1:8000

# 私有化部署才需要改
FEISHU_BASE_URL=https://open.feishu.cn
